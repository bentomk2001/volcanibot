<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>volcanibot_bringup</name>
  <version>0.0.0</version>
  <description>Bringup package for launching the full VolcaniBot simulation and hardware stacks.</description>
  <maintainer email="bentomk@todo.todo">bentomk</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>volcanibot_description</exec_depend>
  <exec_depend>volcanibot_controller</exec_depend>
  <exec_depend>volcanibot_localization</exec_depend>
  <exec_depend>volcanibot_mapping</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

