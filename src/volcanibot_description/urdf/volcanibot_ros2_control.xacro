<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="volcanibot">

    <ros2_control name="RobotSystem" type="system">

        <!-- ros2_control Gazebo -->

        <!-- ROS 2 Iron or above -->
      
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
        
        <!-- ros2_control Common Interfaces -->
        <joint name="wheel_right_fwd_joint">
            <command_interface name="velocity">
              <param name="min">-1</param>  <!-- maximum and minimum speed of hardware (rad/s), change accordingly (atm very low)-->
              <param name="max">1</param>
            </command_interface>
            <state_interface name="position" />  <!-- these are the wheel encoders for gazebo -->
            <state_interface name="velocity" />
        </joint>

        <joint name="wheel_right_bwd_joint">
            <command_interface name="velocity">
              <param name="min">-1</param>
              <param name="max">1</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

         <joint name="wheel_left_fwd_joint">
            <command_interface name="velocity">
              <param name="min">-1</param>
              <param name="max">1</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

         <joint name="wheel_left_bwd_joint">
            <command_interface name="velocity">
              <param name="min">-1</param>
              <param name="max">1</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        
    </ros2_control>

</robot>