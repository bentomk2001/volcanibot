<?xml version="1.0" encoding="utf-8"?>
<robot
  name="volcanibot" xmlns:xacro="http://www.ros.org/wiki/xacro"> <!-- Include Gazebo Parameters -->

  <xacro:include filename="$(find volcanibot_description)/urdf/gazebo.urdf.xacro" />
  <xacro:include filename="$(find volcanibot_description)/urdf/volcanibot_ros2_control.xacro" />
  <!-- Load Simulated or Real Hardware Interfaces -->
  <xacro:arg name="is_sim" default="true"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.0095094 0.0028129 0.16288"
        rpy="0 0 0" />
      <mass
        value="14.159" />
      <inertia
        ixx="0.17563"
        ixy="-0.001306"
        ixz="-0.0070112"
        iyy="0.39929"
        iyz="0.00013202"
        izz="0.51862" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://volcanibot_description/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://volcanibot_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link
    name="wheel_right_fwd_link">
    <inertial>
      <origin
        xyz="1.8016E-09 0.037842 -1.082E-10"
        rpy="0 0 0" />
      <mass
        value="3.4573" />
      <inertia
        ixx="0.018682"
        ixy="-1.5014E-12"
        ixz="1.0733E-07"
        iyy="0.033784"
        iyz="-1.829E-10"
        izz="0.018682" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://volcanibot_description/meshes/wheel_right_fwd_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.29804 0.29804 0.29804 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.04255 0" rpy="1.5708 0 0"/> 
      <geometry>
        <cylinder radius="0.141" length="0.0851"/> 
      </geometry>
    </collision>
  </link>

  <joint
    name="wheel_right_fwd_joint"
    type="continuous">
    <origin
      xyz="0.17967 -0.25921 0.07"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="wheel_right_fwd_link" />
    <axis
      xyz="0 1 0" />
  </joint>

  <link
    name="wheel_right_bwd_link">
    <inertial>
      <origin
        xyz="-1.7943E-09 0.037842 1.9489E-10"
        rpy="0 0 0" />
      <mass
        value="3.4573" />
      <inertia
        ixx="0.018682"
        ixy="1.0313E-11"
        ixz="1.2251E-07"
        iyy="0.033784"
        iyz="1.8262E-10"
        izz="0.018682" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://volcanibot_description/meshes/wheel_right_bwd_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.29804 0.29804 0.29804 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.04255 0" rpy="1.5708 0 0"/> 
      <geometry>
        <cylinder radius="0.141" length="0.0851"/> 
      </geometry>
    </collision>
  </link>

  <joint
    name="wheel_right_bwd_joint"
    type="continuous">
    <origin
      xyz="-0.17985 -0.25921 0.07"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="wheel_right_bwd_link" />
    <axis
      xyz="0 1 0" />
  </joint>

  <link
    name="wheel_left_fwd_link">
    <inertial>
      <origin
        xyz="-1.6762E-09 -0.037495 -6.6918E-10"
        rpy="0 0 0" />
      <mass
        value="3.4573" />
      <inertia
        ixx="0.018682"
        ixy="-7.6518E-11"
        ixz="-5.7075E-08"
        iyy="0.033784"
        iyz="1.6613E-10"
        izz="0.018682" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://volcanibot_description/meshes/wheel_left_fwd_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.29804 0.29804 0.29804 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.04255 0" rpy="1.5708 0 0"/> 
      <geometry>
        <cylinder radius="0.141" length="0.0851"/> 
      </geometry>
    </collision>
  </link>

  <joint
    name="wheel_left_fwd_joint"
    type="continuous">
    <origin
      xyz="0.17967 0.25921 0.07"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="wheel_left_fwd_link" />
    <axis
      xyz="0 1 0" />
  </joint>

  <link
    name="wheel_left_bwd_link">
    <inertial>
      <origin
        xyz="-1.7514E-09 -0.037495 4.3594E-10"
        rpy="0 0 0" />
      <mass
        value="3.4573" />
      <inertia
        ixx="0.018682"
        ixy="3.4934E-11"
        ixz="1.5873E-07"
        iyy="0.033784"
        iyz="1.7954E-10"
        izz="0.018682" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://volcanibot_description/meshes/wheel_left_bwd_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.29804 0.29804 0.29804 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.04255 0" rpy="1.5708 0 0"/> 
      <geometry>
        <cylinder radius="0.141" length="0.0851"/> 
      </geometry>
    </collision>
  </link>

  <joint
    name="wheel_left_bwd_joint"
    type="continuous">
    <origin
      xyz="-0.17985 0.25921 0.07"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="wheel_left_bwd_link" />
    <axis
      xyz="0 1 0" />
  </joint>

  <link
    name="second_floor_link">
    <inertial>
      <origin
        xyz="-0.017662 0.0069891 0.24134"
        rpy="0 0 0" />
      <mass
        value="7.8695" />
      <inertia
        ixx="0.081297"
        ixy="-0.0013078"
        ixz="-0.0069769"
        iyy="0.16836"
        iyz="0.00013321"
        izz="0.22932" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://volcanibot_description/meshes/second_floor_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://volcanibot_description/meshes/second_floor_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="second_floor_joint"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="second_floor_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <!-- when i add specific imu to solid i must change values here!!!-->

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="imu_link" />
  </joint>

  <link name="laser_link">
    <inertial>
      <origin xyz="-0.011945780406062 -0.000381929217680526 -0.0170649378129477" rpy="0 0 0" />
      <mass value="0.073084435549317" />
      <inertia ixx="1.96074931730795E-05" ixy="-3.62091076640009E-07" ixz="4.28230084046735E-07"
               iyy="2.40983835136327E-05" iyz="1.50180909250652E-08"
               izz="4.14184164228595E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://volcanibot_description/meshes/laser_link.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://volcanibot_description/meshes/laser_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="0 0 0.3478" rpy="0 0 3.14" />
    <parent link="second_floor_link" />
    <child link="laser_link" />
    <axis xyz="0 0 0" />
  </joint>

  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  
</robot>