<?xml version="1.0" encoding="utf-8"?>
<robot
  name="volcanibot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- can replace simple frivtion model with wheelslip model if it isnt strong enough-->
  <gazebo reference="wheel_right_fwd_link">
    <mu1>0.8</mu1>
    <mu2>0.5</mu2>
    <kp>100000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="wheel_right_bwd_link">
    <mu1>0.8</mu1>
    <mu2>0.5</mu2>
    <kp>100000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="wheel_left_fwd_link">
    <mu1>0.8</mu1>
    <mu2>0.5</mu2>
    <kp>100000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="wheel_left_bwd_link">
    <mu1>0.8</mu1>
    <mu2>0.5</mu2>
    <kp>100000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo>
        <!-- ROS 2 Iron or above -->
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find volcanibot_controller)/config/volcanibot_controllers.yaml</parameters>
      </plugin>
      <!-- <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
      </plugin>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin> -->

  </gazebo>
    

</robot>